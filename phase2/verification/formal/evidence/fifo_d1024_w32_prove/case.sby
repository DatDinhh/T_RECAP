[options]
mode prove
depth 4
timeout 120

[engines]
smtbmc z3

[script]
read_verilog -formal -sv -D SYNTHESIS stream_fifo.sv fifo_formal.sv
chparam -set DEPTH 1024 -set WIDTH 32 -set CHECK_ORDER 0 -set NEGATIVE 0 fifo_formal
prep -top fifo_formal
async2sync
dffunmap

[files]
stream_fifo.sv
fifo_formal.sv
