{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trecap.local/spec/schemas/de1soc_ddr_ring_ownership.schema.json",
  "title": "T-RECAP Phase 2 Step-12 DE1-SoC DDR ring ownership contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "file_class",
    "project",
    "board",
    "contract_stage",
    "status",
    "implementation_state",
    "source_ownership",
    "reserved_memory_contract",
    "pointer_ownership_contract",
    "wrap_boundary_contract",
    "transport_reset_contract",
    "evidence_policy",
    "validation_rules"
  ],
  "properties": {
    "schema": {"const": "trecap_phase2_de1soc_ddr_ring_ownership_v1"},
    "file_class": {"const": "[1] hand-written Step-12 DDR ring ownership and Linux reservation contract"},
    "project": {"const": "T_RECAP_Phase2"},
    "board": {"const": "de1soc"},
    "contract_stage": {"const": "step12_ddr_ring_ownership_source_implemented"},
    "status": {"const": "source_implemented_pending_active_dtb_integration_linux_boot_runtime_rtl_simulation_quartus_and_hardware_evidence"},
    "implementation_state": {"$ref": "#/$defs/implementationState"},
    "source_ownership": {"$ref": "#/$defs/sourceOwnership"},
    "reserved_memory_contract": {"$ref": "#/$defs/reservedMemory"},
    "pointer_ownership_contract": {"$ref": "#/$defs/pointerOwnership"},
    "wrap_boundary_contract": {"$ref": "#/$defs/wrapBoundary"},
    "transport_reset_contract": {"$ref": "#/$defs/transportReset"},
    "evidence_policy": {"$ref": "#/$defs/evidencePolicy"},
    "validation_rules": {
      "const": [
        "reserved_memory_geometry_matches_address_map_hps_runtime_and_platform_designer_sources",
        "dtsi_uses_exact_static_reg_and_no_map_without_reusable_or_shared_dma_pool",
        "device_tree_reservation_is_the_only_official_active_reservation_mechanism",
        "producer_pointer_has_no_HPS_write_path_and_advances_only_after_successful_DDR_commit",
        "consumer_pointer_changes_only_on_reset_storage_initialization_or_accepted_HPS_commit",
        "consumer_epoch_requires_zero_initial_commit_then_aligned_monotonic_bounded_commits",
        "wrap_required_space_includes_the_entire_physical_tail_and_normal_record",
        "wrap_record_zero_fills_tail_advances_by_tail_and_does_not_consume_sequence",
        "transport_reset_invalidates_configuration_and_consumer_epoch_before_explicit_reinitialization",
        "source_evidence_must_not_be_reported_as_compiled_DTB_boot_runtime_simulation_or_hardware_evidence"
      ]
    }
  },
  "$defs": {
    "implementationState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reserved_memory_dtsi_source_implemented",
        "ownership_contract_source_implemented",
        "source_checker_implemented",
        "rtl_pointer_ownership_source_implemented",
        "rtl_wrap_boundary_source_implemented",
        "deterministic_transport_reset_source_implemented",
        "directed_rtl_testbench_source_implemented",
        "active_board_dtb_integration",
        "compiled_active_dtb_inspection",
        "linux_boot_reservation_evidence",
        "linux_runtime_reservation_evidence",
        "rtl_compile_evidence",
        "rtl_simulation_evidence",
        "platform_designer_generation_evidence",
        "quartus_compile_evidence",
        "timing_closure_evidence",
        "hps_runtime_evidence",
        "hardware_evidence",
        "hardware_signoff"
      ],
      "properties": {
        "reserved_memory_dtsi_source_implemented": {"const": true},
        "ownership_contract_source_implemented": {"const": true},
        "source_checker_implemented": {"const": true},
        "rtl_pointer_ownership_source_implemented": {"const": true},
        "rtl_wrap_boundary_source_implemented": {"const": true},
        "deterministic_transport_reset_source_implemented": {"const": true},
        "directed_rtl_testbench_source_implemented": {"const": true},
        "active_board_dtb_integration": {"const": false},
        "compiled_active_dtb_inspection": {"const": false},
        "linux_boot_reservation_evidence": {"const": false},
        "linux_runtime_reservation_evidence": {"const": false},
        "rtl_compile_evidence": {"const": false},
        "rtl_simulation_evidence": {"const": false},
        "platform_designer_generation_evidence": {"const": false},
        "quartus_compile_evidence": {"const": false},
        "timing_closure_evidence": {"const": false},
        "hps_runtime_evidence": {"const": false},
        "hardware_evidence": {"const": false},
        "hardware_signoff": {"const": false}
      }
    },
    "sourceOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reserved_memory_dtsi",
        "canonical_address_map",
        "platform_designer_hps_config",
        "hps_runtime_config",
        "reservation_bringup_note",
        "ring_pointer_control",
        "ddr_record_builder",
        "ddr_ring_writer",
        "avmm_write_master",
        "csr_bank",
        "hps_bridge_top",
        "rtl_testbench",
        "rtl_test_filelist",
        "human_document",
        "schema_file",
        "source_checker"
      ],
      "properties": {
        "reserved_memory_dtsi": {"const": "platform/de1soc/linux/trecap_reserved_memory.dtsi"},
        "canonical_address_map": {"const": "platform/de1soc/address_map/hps_bridge_regions.json"},
        "platform_designer_hps_config": {"const": "platform/de1soc/qsys/hps_config.tcl"},
        "hps_runtime_config": {"const": "sw/hps/config/trecap_hps_config.json"},
        "reservation_bringup_note": {"const": "sw/hps/scripts/reserve_ddr_region_notes.md"},
        "ring_pointer_control": {"const": "rtl/hps_bridge/trecap_ring_pointer_ctrl.sv"},
        "ddr_record_builder": {"const": "rtl/hps_bridge/trecap_ddr_record_builder.sv"},
        "ddr_ring_writer": {"const": "rtl/hps_bridge/trecap_ddr_ring_writer.sv"},
        "avmm_write_master": {"const": "rtl/hps_bridge/trecap_avmm_write_master.sv"},
        "csr_bank": {"const": "rtl/hps_bridge/trecap_csr_bank.sv"},
        "hps_bridge_top": {"const": "rtl/hps_bridge/trecap_hps_bridge_top.sv"},
        "rtl_testbench": {"const": "sim/tb/tb_trecap_step12_ddr_ring_ownership.sv"},
        "rtl_test_filelist": {"const": "sim/filelists/step12_ddr_ring_ownership.f"},
        "human_document": {"const": "docs/architecture/de1soc_ddr_ring_ownership.md"},
        "schema_file": {"const": "spec/schemas/de1soc_ddr_ring_ownership.schema.json"},
        "source_checker": {"const": "scripts/check_ddr_ring_ownership.py"}
      }
    },
    "reservedMemory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "official_reservation_mechanism",
        "official_mechanism_count",
        "kernel_memory_limit_bootarg_is_active_alternative",
        "dtsi_label",
        "dtsi_node_name",
        "address_cells",
        "size_cells",
        "empty_ranges_property_required",
        "hps_physical_base",
        "fpga_visible_base",
        "size_bytes",
        "end_exclusive",
        "guard_bytes",
        "record_alignment_bytes",
        "natural_alignment_bytes",
        "no_map",
        "reusable",
        "shared_dma_pool",
        "linux_allocator_may_use_region",
        "must_be_present_in_fdt_before_linux_boot",
        "runtime_configfs_overlay_is_sufficient"
      ],
      "properties": {
        "official_reservation_mechanism": {"const": "device_tree_reserved_memory_no_map"},
        "official_mechanism_count": {"const": 1},
        "kernel_memory_limit_bootarg_is_active_alternative": {"const": false},
        "dtsi_label": {"const": "trecap_telemetry_ring"},
        "dtsi_node_name": {"const": "trecap-ring@3e000000"},
        "address_cells": {"const": 1},
        "size_cells": {"const": 1},
        "empty_ranges_property_required": {"const": true},
        "hps_physical_base": {"const": "0x000000003e000000"},
        "fpga_visible_base": {"const": "0x000000003e000000"},
        "size_bytes": {"const": 33554432},
        "end_exclusive": {"const": "0x0000000040000000"},
        "guard_bytes": {"const": 64},
        "record_alignment_bytes": {"const": 64},
        "natural_alignment_bytes": {"const": 33554432},
        "no_map": {"const": true},
        "reusable": {"const": false},
        "shared_dma_pool": {"const": false},
        "linux_allocator_may_use_region": {"const": false},
        "must_be_present_in_fdt_before_linux_boot": {"const": true},
        "runtime_configfs_overlay_is_sufficient": {"const": false}
      }
    },
    "pointerOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pointer_width_bits",
        "pointer_unit",
        "pointer_model",
        "physical_offset_rule",
        "valid_used_range_rule",
        "producer_pointer",
        "producer_owner",
        "producer_software_write_csr_permitted",
        "producer_hps_access",
        "producer_advances_only_after_all_record_ddr_writes_complete_successfully",
        "consumer_pointer",
        "consumer_owner",
        "consumer_runtime_assignment_source",
        "consumer_async_reset_storage_initializes_zero",
        "soft_reset_directly_assigns_consumer_pointer",
        "ring_config_commit_directly_assigns_consumer_pointer",
        "consumer_epoch_valid_required_for_write_admission",
        "consumer_epoch_invalidated_by",
        "consumer_first_commit_in_epoch_must_equal_zero",
        "consumer_runtime_commit_alignment_bytes",
        "consumer_runtime_commit_must_not_move_backward",
        "consumer_runtime_commit_must_not_exceed_producer",
        "consumer_runtime_commit_must_keep_used_within_ring",
        "ring_writer_enable_requires_ring_configured_and_consumer_epoch_valid",
        "normal_commit_consumes_sequence",
        "wrap_commit_consumes_sequence"
      ],
      "properties": {
        "pointer_width_bits": {"const": 64},
        "pointer_unit": {"const": "bytes"},
        "pointer_model": {"const": "absolute_monotonic_with_epoch_reset"},
        "physical_offset_rule": {"const": "off(p)=p&(R-1)"},
        "valid_used_range_rule": {"const": "0<=W-Rd<=R"},
        "producer_pointer": {"const": "W"},
        "producer_owner": {"const": "FPGA_DDR_ring_writer_only"},
        "producer_software_write_csr_permitted": {"const": false},
        "producer_hps_access": {"const": "atomic_snapshot_read_only"},
        "producer_advances_only_after_all_record_ddr_writes_complete_successfully": {"const": true},
        "consumer_pointer": {"const": "Rd"},
        "consumer_owner": {"const": "HPS_shadow_commit_only"},
        "consumer_runtime_assignment_source": {"const": "accepted_RING_RD_COMMIT"},
        "consumer_async_reset_storage_initializes_zero": {"const": true},
        "soft_reset_directly_assigns_consumer_pointer": {"const": false},
        "ring_config_commit_directly_assigns_consumer_pointer": {"const": false},
        "consumer_epoch_valid_required_for_write_admission": {"const": true},
        "consumer_epoch_invalidated_by": {
          "const": ["telemetry_soft_reset", "ring_config_commit", "external_transport_reset"]
        },
        "consumer_first_commit_in_epoch_must_equal_zero": {"const": true},
        "consumer_runtime_commit_alignment_bytes": {"const": 64},
        "consumer_runtime_commit_must_not_move_backward": {"const": true},
        "consumer_runtime_commit_must_not_exceed_producer": {"const": true},
        "consumer_runtime_commit_must_keep_used_within_ring": {"const": true},
        "ring_writer_enable_requires_ring_configured_and_consumer_epoch_valid": {"const": true},
        "normal_commit_consumes_sequence": {"const": true},
        "wrap_commit_consumes_sequence": {"const": false}
      }
    },
    "wrapBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "header_bytes",
        "normal_record_length_rule",
        "normal_record_crosses_ring_end_permitted",
        "wrap_required_rule",
        "tail_rule",
        "required_free_space_without_wrap",
        "required_free_space_with_wrap",
        "available_free_space_rule",
        "wrap_packet_type",
        "wrap_payload_bytes",
        "wrap_effective_length_rule",
        "generic_normal_length_rule_applies_to_wrap",
        "wrap_minimum_tail_bytes",
        "wrap_header_followed_by_zero_padding_through_ring_end",
        "wrap_commits_only_after_all_tail_writes_complete_successfully",
        "producer_advance_after_wrap_rule",
        "normal_record_after_wrap_starts_at_offset_zero",
        "wrap_sequence_field",
        "wrap_consumes_pc_visible_sequence",
        "insufficient_required_space_drops_record",
        "insufficient_required_space_advances_producer"
      ],
      "properties": {
        "header_bytes": {"const": 32},
        "normal_record_length_rule": {"const": "Lrec=align64(header_bytes+payload_bytes)"},
        "normal_record_crosses_ring_end_permitted": {"const": false},
        "wrap_required_rule": {"const": "off(W)+Lrec>R"},
        "tail_rule": {"const": "Ttail=R-off(W)"},
        "required_free_space_without_wrap": {"const": "Lrec"},
        "required_free_space_with_wrap": {"const": "Ttail+Lrec"},
        "available_free_space_rule": {"const": "R-(W-Rd)-guard"},
        "wrap_packet_type": {"const": "0x007f"},
        "wrap_payload_bytes": {"const": 0},
        "wrap_effective_length_rule": {"const": "Ttail"},
        "generic_normal_length_rule_applies_to_wrap": {"const": false},
        "wrap_minimum_tail_bytes": {"const": 64},
        "wrap_header_followed_by_zero_padding_through_ring_end": {"const": true},
        "wrap_commits_only_after_all_tail_writes_complete_successfully": {"const": true},
        "producer_advance_after_wrap_rule": {"const": "W=W+Ttail"},
        "normal_record_after_wrap_starts_at_offset_zero": {"const": true},
        "wrap_sequence_field": {"const": 0},
        "wrap_consumes_pc_visible_sequence": {"const": false},
        "insufficient_required_space_drops_record": {"const": true},
        "insufficient_required_space_advances_producer": {"const": false}
      }
    },
    "transportReset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence_owner",
        "required_sequence",
        "writer_idle_required_before_soft_reset",
        "soft_reset_resets_fpga_producer_and_sequence",
        "soft_reset_invalidates_ring_configuration",
        "soft_reset_invalidates_consumer_epoch",
        "ring_config_commit_resets_fpga_producer_and_sequence",
        "ring_config_commit_invalidates_consumer_epoch",
        "hps_commit_Rd_zero_required_after_config",
        "W_zero_snapshot_required_before_enable",
        "writer_state_after_complete_sequence",
        "reader_state_after_complete_sequence",
        "enable_before_complete_sequence_permitted"
      ],
      "properties": {
        "sequence_owner": {"const": "HPS_control_plane"},
        "required_sequence": {
          "const": [
            "clear_telemetry_enable_and_ring_writer_enable",
            "wait_for_writer_idle",
            "pulse_telemetry_soft_reset_once",
            "write_ring_base_and_size",
            "pulse_ring_config_commit_while_disabled",
            "commit_Rd_zero_from_HPS",
            "verify_W_zero_snapshot",
            "enable_ring_writer_then_telemetry"
          ]
        },
        "writer_idle_required_before_soft_reset": {"const": true},
        "soft_reset_resets_fpga_producer_and_sequence": {"const": true},
        "soft_reset_invalidates_ring_configuration": {"const": true},
        "soft_reset_invalidates_consumer_epoch": {"const": true},
        "ring_config_commit_resets_fpga_producer_and_sequence": {"const": true},
        "ring_config_commit_invalidates_consumer_epoch": {"const": true},
        "hps_commit_Rd_zero_required_after_config": {"const": true},
        "W_zero_snapshot_required_before_enable": {"const": true},
        "writer_state_after_complete_sequence": {"const": "idle_configured_W_zero_sequence_zero"},
        "reader_state_after_complete_sequence": {"const": "epoch_valid_Rd_zero"},
        "enable_before_complete_sequence_permitted": {"const": false}
      }
    },
    "evidencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_checker",
        "schema_file",
        "human_document",
        "default_checker_scope",
        "external_tool_execution_performed_by_checker",
        "source_check_is_dts_compile",
        "source_check_is_active_dtb_integration",
        "source_check_is_linux_boot_evidence",
        "source_check_is_linux_runtime_evidence",
        "source_check_is_rtl_compile",
        "source_check_is_rtl_simulation",
        "source_check_is_platform_designer_generation",
        "source_check_is_quartus_compile",
        "source_check_is_timing_closure",
        "source_check_is_hps_runtime_evidence",
        "source_check_is_hardware_evidence",
        "source_check_is_hardware_signoff"
      ],
      "properties": {
        "source_checker": {"const": "scripts/check_ddr_ring_ownership.py"},
        "schema_file": {"const": "spec/schemas/de1soc_ddr_ring_ownership.schema.json"},
        "human_document": {"const": "docs/architecture/de1soc_ddr_ring_ownership.md"},
        "default_checker_scope": {"const": "source_only"},
        "external_tool_execution_performed_by_checker": {"const": false},
        "source_check_is_dts_compile": {"const": false},
        "source_check_is_active_dtb_integration": {"const": false},
        "source_check_is_linux_boot_evidence": {"const": false},
        "source_check_is_linux_runtime_evidence": {"const": false},
        "source_check_is_rtl_compile": {"const": false},
        "source_check_is_rtl_simulation": {"const": false},
        "source_check_is_platform_designer_generation": {"const": false},
        "source_check_is_quartus_compile": {"const": false},
        "source_check_is_timing_closure": {"const": false},
        "source_check_is_hps_runtime_evidence": {"const": false},
        "source_check_is_hardware_evidence": {"const": false},
        "source_check_is_hardware_signoff": {"const": false}
      }
    }
  }
}
