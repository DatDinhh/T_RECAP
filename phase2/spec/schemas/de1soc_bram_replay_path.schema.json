        "denied_explicit_start_emits_reject_evidence",
        "mathematical_core_instances_per_composition",
        "source_to_y_stages",
        "tap_to_hps_ddr_stages",
        "tap_transport_semantic",
        "telemetry_or_ddr_ready_to_core_permitted",
        "pin_agnostic_y_ready_owner",
        "board_y_ready_owner",
        "safe_idle_transport_substitute_permitted",
        "generated_platform_designer_hdl_required_for_board_build"
      ],
      "properties": {
        "pin_agnostic_top_module": {"const": "trecap_bram_replay_system_top"},
        "physical_top_module": {"const": "de1_soc_trecap_top"},
        "profile_source_mode": {"const": "TSRC_BRAM_REPLAY"},
        "reset_source_mode": {"const": "TSRC_BRAM_REPLAY"},
        "runtime_source_mode_owner": {"const": "ctrl.source_mode_and_source_mode_apply_pulse"},
        "pin_agnostic_source_mode_locked": {"const": false},
        "source_mode_commit_permitted_in_pin_agnostic_top": {"const": true},
        "replay_start_requires_active_bram_mode": {"const": true},
        "raw_replay_start_request_reaches_source_owner": {"const": true},
        "replay_start_admission_owner": {"const": "composition_status_only_transport_gate"},
        "replay_start_admission_requires": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "status_only_transport_ready",
              "transport_epoch_idle",
              "no_e2e_epoch_inflight"
            ]
          }
        },
        "transport_epoch_idle_signal": {"const": "transport_epoch_idle_o"},
        "transport_epoch_idle_semantic": {"const": "writer_idle_and_no_fifo_record_valid"},
        "denied_explicit_start_emits_reject_evidence": {"const": true},
        "mathematical_core_instances_per_composition": {"const": 1},
        "source_to_y_stages": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "trecap_bram_replay_source",
              "trecap_source_mux",
              "trecap_core_top",
              "public_y_ready_valid_sink"
            ]
          }
        },
        "tap_to_hps_ddr_stages": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "enum": [
              "real_trecap_core_top_taps_and_counters",
              "trecap_de1soc_full_top",
              "trecap_telemetry_top",
              "trecap_packet_fifo",
              "trecap_hps_bridge_top",
              "trecap_ddr_ring_writer",
              "Avalon_MM_write_master",
              "platform_designer_wrapper",
              "generated_F2SDRAM_bridge",
              "HPS_DDR3"
            ]
          }
        },
        "tap_transport_semantic": {"const": "valid_only_observer"},
        "telemetry_or_ddr_ready_to_core_permitted": {"const": false},
        "pin_agnostic_y_ready_owner": {"const": "external_test_or_capture_sink"},
        "board_y_ready_owner": {"const": "constant_one_non_stalling_sink"},
        "safe_idle_transport_substitute_permitted": {"const": false},
        "generated_platform_designer_hdl_required_for_board_build": {"const": true}
      }
    },
    "exactCompletion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completion_scope",
        "monitor_owner",
        "monitor_block_label",
        "source_done_signal",
        "source_done_semantic",
        "source_done_is_exact_path_done",
        "source_done_may_precede_path_done",
        "path_busy_signal",
        "path_done_signal",
        "path_done_pulse_signal",
        "completion_error_signal",
        "accepted_y_event",
        "accepted_y_index_must_be_contiguous_from_zero",
        "path_done_requires_source_done",
        "path_done_requires_structural_quiescence",
        "path_done_requires_no_fault",
        "path_done_is_stable_level_until_new_epoch_or_clear",
        "failed_epoch_holds_busy_until_clear_or_reset",
        "exact_count_requirements",
        "structural_busy_terms",
        "geometry"
      ],
      "properties": {
        "completion_scope": {"const": "bram_source_through_mathematical_core_y_only"},
        "monitor_owner": {"const": "trecap_source_core_integration"},
        "monitor_block_label": {"const": "p_replay_exact_completion"},
        "source_done_signal": {"const": "replay_done_o"},
        "source_done_semantic": {"const": "final_bram_or_flush_source_token_accepted"},
        "source_done_is_exact_path_done": {"const": false},
        "source_done_may_precede_path_done": {"const": true},
        "path_busy_signal": {"const": "replay_path_busy_o"},
        "path_done_signal": {"const": "replay_path_done_o"},
        "path_done_pulse_signal": {"const": "replay_path_done_pulse_o"},
        "completion_error_signal": {"const": "replay_completion_error_sticky_o"},
        "accepted_y_event": {"const": "y_valid_o&&y_ready_i"},
        "accepted_y_index_must_be_contiguous_from_zero": {"const": true},
        "path_done_requires_source_done": {"const": true},
        "path_done_requires_structural_quiescence": {"const": true},
        "path_done_requires_no_fault": {"const": true},
        "path_done_is_stable_level_until_new_epoch_or_clear": {"const": true},
        "failed_epoch_holds_busy_until_clear_or_reset": {"const": true},
        "exact_count_requirements": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "replay_core_output_accept_count==Ny",
              "replay_source_output_accept_count==Ny",
              "wola_output_count==Ny",
              "core_sample_count==tau_last",
              "core_frame_count==Nframes",
              "core_error_sample_count==Ny",
              "replay_epoch_metric_commit_count==Ny"
            ]
          }
        },
        "structural_busy_terms": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "replay_active",
              "selected_source_valid",
              "core_busy",
              "public_y_valid"
            ]
          }
        },
        "geometry": {"$ref": "#/$defs/geometry"}
      }
    },
    "e2eCompletion": {
      "type": "object",
      "additionalProperties": false,
