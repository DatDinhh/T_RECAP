        "failed_epoch_holds_busy_until_clear_or_reset",
        "forbidden_completion_events"
      ],
      "properties": {
        "supervisor_owner": {"const": "trecap_bram_replay_e2e_supervisor"},
        "supervisor_source": {"const": "rtl/top/trecap_bram_replay_e2e_supervisor.sv"},
        "supervisor_instance": {"const": "u_replay_e2e_supervisor"},
        "supervisor_block_label": {"const": "p_replay_e2e_completion"},
        "core_path_done_signal": {"const": "replay_path_done_o"},
