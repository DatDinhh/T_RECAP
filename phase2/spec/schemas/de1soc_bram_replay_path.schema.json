        "mathematical_core": {"const": "rtl/core/trecap_core_top.sv"},
        "logical_telemetry_hps_top": {"const": "rtl/top/trecap_de1soc_full_top.sv"},
        "telemetry_top": {"const": "rtl/telemetry/trecap_telemetry_top.sv"},
        "hps_bridge_top": {"const": "rtl/hps_bridge/trecap_hps_bridge_top.sv"},
        "ddr_ring_writer": {"const": "rtl/hps_bridge/trecap_ddr_ring_writer.sv"},
        "platform_designer_wrapper": {"const": "rtl/platform/de1soc/platform_designer_wrapper.sv"},
        "physical_board_top": {"const": "rtl/platform/de1soc/de1_soc_trecap_top.sv"},
        "board_profile": {"const": "config/profiles/de1soc_bram_replay.json"},
        "rtl_testbench": {"const": "sim/tb/tb_trecap_step11_bram_e2e.sv"},
        "rtl_test_filelist": {"const": "sim/filelists/step11_bram_e2e.f"},
        "reference_import_manifest": {"const": "artifacts/manifests/reference_import_manifest.json"},
        "human_document": {"const": "docs/architecture/de1soc_bram_replay_path.md"},
        "schema_file": {"const": "spec/schemas/de1soc_bram_replay_path.schema.json"},
        "source_checker": {"const": "scripts/check_bram_replay_path.py"}
      }
    },
    "replayPath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pin_agnostic_top_module",
        "physical_top_module",
        "profile_source_mode",
        "reset_source_mode",
        "runtime_source_mode_owner",
        "pin_agnostic_source_mode_locked",
        "source_mode_commit_permitted_in_pin_agnostic_top",
        "replay_start_requires_active_bram_mode",
        "raw_replay_start_request_reaches_source_owner",
