    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Nframes_formula",
        "tau_last_formula",
        "Ny_formula",
        "drain_formula",
        "baseline_L",
        "baseline_H",
        "baseline_G",
        "baseline_D"
      ],
      "properties": {
        "Nframes_formula": {"const": "floor((Ns+L-2)/H)"},
        "tau_last_formula": {"const": "Nframes*H"},
        "Ny_formula": {"const": "tau_last+G+L"},
        "drain_formula": {"const": "G+L"},
        "baseline_L": {"const": 256},
        "baseline_H": {"const": 128},
        "baseline_G": {"const": 128},
        "baseline_D": {"const": 384}
      }
    },
