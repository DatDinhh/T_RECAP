      "type": "object",
      "additionalProperties": false,
      "required": [
        "pin_agnostic_system_top",
        "e2e_supervisor",
        "source_core_and_completion_monitor",
        "bram_replay_source",
        "mathematical_core",
        "logical_telemetry_hps_top",
        "telemetry_top",
        "hps_bridge_top",
        "ddr_ring_writer",
        "platform_designer_wrapper",
