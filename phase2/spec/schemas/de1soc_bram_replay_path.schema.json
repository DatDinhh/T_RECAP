        "zero_vector_board_profile_declared",
        "impulse_rtl_regression_source_declared",
        "rtl_compile",
        "functional_verification",
        "platform_designer_generation",
        "quartus_compile",
        "timing_closure",
        "hardware_bram_replay",
        "hardware_ddr_hps_capture",
        "hardware_signoff"
      ],
      "properties": {
        "pin_agnostic_replay_system_source_implemented": {"const": true},
        "exact_completion_monitor_source_implemented": {"const": true},
        "e2e_completion_supervisor_source_implemented": {"const": true},
        "board_exact_completion_status_bound": {"const": true},
        "real_taps_to_telemetry_hps_ddr_source_bound": {"const": true},
        "zero_vector_board_profile_declared": {"const": true},
        "impulse_rtl_regression_source_declared": {"const": true},
        "rtl_compile": {"const": false},
        "functional_verification": {"const": false},
        "platform_designer_generation": {"const": false},
        "quartus_compile": {"const": false},
        "timing_closure": {"const": false},
        "hardware_bram_replay": {"const": false},
        "hardware_ddr_hps_capture": {"const": false},
        "hardware_signoff": {"const": false}
      }
    },
