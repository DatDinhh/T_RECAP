{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trecap.local/spec/schemas/de1soc_bram_replay_path.schema.json",
  "title": "T-RECAP Phase 2 Step-11 DE1-SoC BRAM replay path contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "file_class",
    "project",
    "board",
    "contract_stage",
    "status",
    "implementation_state",
    "source_ownership",
    "replay_path",
    "exact_completion_contract",
    "e2e_completion_contract",
    "board_profile_contract",
    "rtl_regression_contract",
    "reference_provenance",
    "evidence_policy",
    "validation_rules"
  ],
  "properties": {
    "schema": {"const": "trecap_phase2_de1soc_bram_replay_path_v1"},
    "file_class": {"const": "[1] hand-written Step-11 BRAM replay path contract"},
    "project": {"const": "T_RECAP_Phase2"},
    "board": {"const": "de1soc"},
    "contract_stage": {"const": "step11_bram_replay_path_source_implemented"},
    "status": {"const": "source_implemented_pending_rtl_compile_functional_verification_platform_designer_generation_quartus_timing_and_hardware_evidence"},
    "implementation_state": {"$ref": "#/$defs/implementationState"},
    "source_ownership": {"$ref": "#/$defs/sourceOwnership"},
    "replay_path": {"$ref": "#/$defs/replayPath"},
    "exact_completion_contract": {"$ref": "#/$defs/exactCompletion"},
    "e2e_completion_contract": {"$ref": "#/$defs/e2eCompletion"},
    "board_profile_contract": {"$ref": "#/$defs/boardProfile"},
    "rtl_regression_contract": {"$ref": "#/$defs/rtlRegression"},
    "reference_provenance": {"$ref": "#/$defs/referenceProvenance"},
    "evidence_policy": {"$ref": "#/$defs/evidencePolicy"},
    "validation_rules": {
      "type": "array",
      "minItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 30}
    }
  },
  "$defs": {
