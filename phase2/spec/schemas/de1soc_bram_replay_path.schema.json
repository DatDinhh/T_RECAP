        "accepted_start_telemetry_flush_requires_epoch_idle",
        "accepted_start_external_transport_clear_permitted",
        "accepted_start_preserves_committed_ring_state",
        "pin_agnostic_clear_or_disable_clears_transport_epoch",
        "hps_telemetry_soft_reset_scope",
        "board_replay_rearm_binding",
        "board_replay_rearm_scope",
        "board_replay_rearm_telemetry_flush_permitted",
        "board_replay_rearm_preserves_transport_state",
        "drop_baseline_captured_after_accepted_start_telemetry_flush",
        "fault_capture_active_on_accepted_start_edge",
        "fault_capture_active_during_baseline_cycle",
        "baseline_capture_has_fault_blind_window",
        "periodic_status_suppressed_during_replay_epoch",
        "post_core_status_request_trigger",
        "transport_observation_must_follow_core_path_done",
        "required_transport_packet",
        "required_commit_kind",
        "normal_commit_requires_all_local_avmm_beat_responses_ok",
        "pin_agnostic_tb_avmm_response_model",
        "physical_board_local_response_owner",
        "physical_board_okay_semantic",
        "physical_board_range_reject_response",
        "physical_board_e2e_proves_physical_dram_durability",
        "physical_board_e2e_proves_downstream_error_visibility",
        "post_core_transport_baseline_captured_on_path_done",
        "normal_commit_must_follow_core_path_done",
        "producer_pointer_must_advance_from_post_core_baseline",
        "dma_packet_count_must_advance_from_post_core_baseline",
        "writer_must_be_idle_at_done",
        "e2e_done_requires_no_replay_core_telemetry_or_ddr_fault",
        "e2e_done_is_stable_level_until_new_epoch_or_clear",
