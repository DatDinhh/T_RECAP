        "accepted_start_flushes_uncommitted_telemetry_state": {"const": true},
        "accepted_start_telemetry_flush_scope": {"const": "packetizer_and_packet_fifo_only"},
        "accepted_start_telemetry_flush_requires_epoch_idle": {"const": true},
        "accepted_start_external_transport_clear_permitted": {"const": false},
        "accepted_start_preserves_committed_ring_state": {"const": true},
        "pin_agnostic_clear_or_disable_clears_transport_epoch": {"const": true},
        "hps_telemetry_soft_reset_scope": {"const": "transport_only_frozen_control_contract"},
        "board_replay_rearm_binding": {"const": "key_press_pulse[3]"},
        "board_replay_rearm_scope": {"const": "source_core_and_e2e_only_preserve_transport_state"},
        "board_replay_rearm_telemetry_flush_permitted": {"const": false},
        "board_replay_rearm_preserves_transport_state": {"const": true},
        "drop_baseline_captured_after_accepted_start_telemetry_flush": {"const": true},
        "fault_capture_active_on_accepted_start_edge": {"const": true},
        "fault_capture_active_during_baseline_cycle": {"const": true},
        "baseline_capture_has_fault_blind_window": {"const": false},
        "periodic_status_suppressed_during_replay_epoch": {"const": true},
        "post_core_status_request_trigger": {"const": "replay_path_done_pulse"},
        "transport_observation_must_follow_core_path_done": {"const": true},
        "required_transport_packet": {"const": "new_STATUS_record_for_completed_replay_epoch"},
        "required_commit_kind": {"const": "normal_DDR_ring_commit"},
        "normal_commit_requires_all_local_avmm_beat_responses_ok": {"const": true},
        "pin_agnostic_tb_avmm_response_model": {"const": "delayed_OKAY_and_SLVERR_injection"},
        "physical_board_local_response_owner": {"const": "platform_designer_wrapper"},
        "physical_board_okay_semantic": {"const": "legal_F2SDRAM_request_accepted_across_waitrequest_boundary"},
        "physical_board_range_reject_response": {"const": "SLVERR"},
        "physical_board_e2e_proves_physical_dram_durability": {"const": false},
        "physical_board_e2e_proves_downstream_error_visibility": {"const": false},
        "post_core_transport_baseline_captured_on_path_done": {"const": true},
        "normal_commit_must_follow_core_path_done": {"const": true},
        "producer_pointer_must_advance_from_post_core_baseline": {"const": true},
        "dma_packet_count_must_advance_from_post_core_baseline": {"const": true},
        "writer_must_be_idle_at_done": {"const": true},
        "e2e_done_requires_no_replay_core_telemetry_or_ddr_fault": {"const": true},
        "e2e_done_is_stable_level_until_new_epoch_or_clear": {"const": true},
        "e2e_done_semantic": {"const": "retained_historical_terminal_evidence_for_correlated_replay_status_epoch"},
        "e2e_done_is_live_global_transport_health": {"const": false},
        "terminal_success_requires_no_correlated_avmm_response_outstanding": {"const": true},
        "later_unrelated_transport_fault_retroactively_invalidates_epoch": {"const": false},
        "later_unrelated_transport_fault_reporting": {"const": "normal_transport_fault_and_status_channels"},
        "retained_epoch_result_invalidated_on_new_epoch_or_defined_clear_rearm": {"const": true},
        "failed_epoch_holds_busy_until_clear_or_reset": {"const": true},
        "forbidden_completion_events": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "enum": [
              "source_done_without_core_path_done",
              "core_path_done_without_post_completion_STATUS_commit",
              "wrap_commit_instead_of_normal_commit",
              "producer_pointer_without_advance",
              "dma_packet_count_without_advance",
              "writer_still_busy",
              "packet_fifo_drop",
              "dma_drop",
              "replay_core_or_transport_fault"
            ]
          }
        }
      }
