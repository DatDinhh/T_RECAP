        "existing_offsets_0x000_through_0x088_unchanged": {"const": true},
        "registers": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/csrRegister"}
        },
        "status_extension_fields": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/bitField"}
        },
        "status_source_pending_rule": {"const": "STATUS.source_commit_pending_is_one_when_commit_pending_or_requested_mode_differs_from_actual_mode"}
      }
    },
    "replay_command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_command",
        "start_write",
        "rearm_write",
        "start_policy",
        "result_epoch_policy",
        "board_key_events_modify_csr_command_result",
        "acceptance_observation"
      ],
      "properties": {
        "start_command": {"const": "START_BRAM_REPLAY"},
        "start_write": {"const": "REPLAY_CONTROL.start"},
        "rearm_write": {"const": "REPLAY_CONTROL.rearm"},
        "start_policy": {"const": "pulse_raw_request_and_report_accept_or_reject_from_replay_owner"},
        "result_epoch_policy": {"const": "increment_on_each_CSR_originated_accept_or_reject_completion"},
        "board_key_events_modify_csr_command_result": {"const": false},
        "acceptance_observation": {"const": "REPLAY_STATUS_last_accept_last_reject_pending_and_result_epoch"}
      }
    },
    "command_service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nonblocking",
        "maximum_datagrams_per_streamer_pass",
        "ring_service_must_not_be_starved",
        "simple_csr_commands_owner",
        "lifecycle_and_replay_owner",
        "compatibility_direct_helper_policy",
        "identity_required_before_noop_or_applied",
        "read_status_version_identity_exception",
        "response_destination"
      ],
      "properties": {
        "nonblocking": {"const": true},
        "maximum_datagrams_per_streamer_pass": {"const": 64},
        "ring_service_must_not_be_starved": {"const": true},
        "simple_csr_commands_owner": {"const": "command_bridge_for_live_network_path"},
        "lifecycle_and_replay_owner": {"const": "command_bridge"},
        "compatibility_direct_helper_policy": {"const": "command_apply_to_csr_not_used_by_live_streamer"},
        "identity_required_before_noop_or_applied": {"const": "every_command_except_PING_and_READ_STATUS_VERSION"},
        "read_status_version_identity_exception": {"const": "return_raw_STATUS_and_VERSION_as_NOOP_even_when_incompatible; only_read_failure_is_FAILED"},
        "response_destination": {"const": "exact_validated_request_source_ip_and_port"}
      }
    },
    "verification_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checker",
        "rtl_structural_checker",
        "rtl_testbench_source",
        "rtl_filelist_source",
        "hps_host_test",
        "pc_host_test",
        "rtl_structural_checker_execution_evidence_packaged",
        "host_test_execution_evidence_packaged",
        "native_rtl_simulation_evidence_packaged",
        "quartus_or_hardware_evidence_packaged"
      ],
      "properties": {
        "checker": {"const": "scripts/check_command_path.py"},
        "rtl_structural_checker": {"const": "sim/check_step14_command_rtl.py"},
        "rtl_testbench_source": {"const": "sim/tb/tb_trecap_step14_command_csr.sv"},
        "rtl_filelist_source": {"const": "sim/filelists/step14_command_csr.f"},
        "hps_host_test": {"const": "sw/hps/tests/test_step14_command_path.c"},
        "pc_host_test": {"const": "sw/pc_dashboard/tests/test_step14_command_client.py"},
        "rtl_structural_checker_execution_evidence_packaged": {"const": false},
        "host_test_execution_evidence_packaged": {"const": false},
        "native_rtl_simulation_evidence_packaged": {"const": false},
        "quartus_or_hardware_evidence_packaged": {"const": false}
      }
    },
    "evidence_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_implementation_claimed",
        "rtl_structural_checker_source_claimed",
        "rtl_testbench_source_claimed",
        "host_test_source_claimed",
        "host_test_execution_packaged",
