        "rtl_testbench_source_claimed": {"const": true},
        "host_test_source_claimed": {"const": true},
        "host_test_execution_packaged": {"const": false},
        "live_pc_hps_udp": {"const": false},
        "hps_linux_runtime": {"const": false},
        "csr_mmap_runtime": {"const": false},
        "lightweight_bridge_runtime": {"const": false},
        "fpga_command_application": {"const": false},
        "bram_replay_hardware": {"const": false},
        "rtl_simulation": {"const": false},
        "platform_designer_generation": {"const": false},
        "quartus_timing": {"const": false},
        "physical_hardware": {"const": false}
      }
    }
  },
  "$defs": {
    "nameCode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "code"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "code": {
          "oneOf": [
            {"type": "integer", "minimum": 0, "maximum": 4294967295},
            {"type": "string", "pattern": "^0x[0-9A-F]{4,8}$"}
          ]
        }
      }
    },
    "commandWithArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "code", "args"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "code": {"type": "string", "pattern": "^0x[0-9A-F]{4}$"},
        "args": {
          "type": "object",
          "additionalProperties": false,
          "required": ["arg0", "arg1", "arg2"],
          "properties": {
            "arg0": {"type": "string", "minLength": 1},
            "arg1": {"type": "string", "minLength": 1},
            "arg2": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "version1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "result_defined", "exact_command_types"],
      "properties": {
        "version": {"const": 1},
        "result_defined": {"const": false},
        "exact_command_types": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {"$ref": "#/$defs/nameCode"}
        }
      }
    },
    "version2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "inherits_version_1_command_types", "extension_command_types", "ping_policy"],
      "properties": {
        "version": {"const": 2},
        "inherits_version_1_command_types": {"const": true},
        "extension_command_types": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {"$ref": "#/$defs/commandWithArgs"}
        },
        "ping_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["arguments", "response", "diagnostic_status_seq", "command_result_emitted", "csr_access", "mutation_ledger_effect"],
          "properties": {
            "arguments": {"const": "ignored"},
            "response": {"const": "fresh_diagnostic_status_only"},
            "diagnostic_status_seq": {"const": 0},
            "command_result_emitted": {"const": false},
            "csr_access": {"const": false},
            "mutation_ledger_effect": {"const": "none"}
          }
        }
      }
    },
    "wireField": {
      "type": "object",
      "required": ["name", "offset", "type"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "offset": {"type": "integer", "minimum": 0, "maximum": 28},
        "type": {"enum": ["uint16", "uint32"]},
        "required_value": {},
        "source": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "resultLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "size_bytes", "fields", "dispositions", "reject_reasons"],
      "properties": {
        "version": {"const": 2},
        "size_bytes": {"const": 32},
        "fields": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {"$ref": "#/$defs/wireField"}
        },
        "dispositions": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/nameCode"}
        },
        "reject_reasons": {
          "type": "array",
          "minItems": 17,
          "maxItems": 17,
          "items": {"$ref": "#/$defs/nameCode"}
        }
      }
    },
    "bitField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "lsb", "msb"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
        "lsb": {"type": "integer", "minimum": 0, "maximum": 31},
        "msb": {"type": "integer", "minimum": 0, "maximum": 31}
      }
    },
    "csrRegister": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "offset", "access", "fields"],
      "properties": {
        "name": {"enum": ["COUNTER_CLEAR", "REPLAY_CONTROL", "REPLAY_STATUS"]},
        "offset": {"enum": ["0x08C", "0x090", "0x094"]},
        "access": {"enum": ["W1P", "R"]},
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/bitField"}
        }
      }
    }
  }
}
