    "codec_configuration_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_rate_hz",
        "word_width_bits",
        "serial_format",
        "clock_role",
        "i2s_data_delay_bits",
        "ack_required_after_every_transmitted_byte",
