        "independent_multibit_payload_synchronizers_permitted": {
          "const": false
        },
        "stale_rx_frames_across_disabled_source_epoch_permitted": {
          "const": false
        },
        "counter_width_bits": {
          "const": 64
        },
        "counter_arithmetic": {
          "const": "saturating_unsigned"
        },
        "counter_clear": {
          "const": "clear_sticky_i"
        },
        "counter_outputs": {
          "const": [
            {
              "name": "audio_rx_overflow_count_o",
