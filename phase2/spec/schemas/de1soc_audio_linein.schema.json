        "sample_rate_hz": {
          "const": 48000
        },
        "word_width_bits": {
          "const": 16
        },
        "serial_format": {
          "const": "i2s"
        },
        "clock_role": {
          "const": "codec_master"
        },
        "i2s_data_delay_bits": {
          "const": 1
        },
        "ack_required_after_every_transmitted_byte": {
          "const": true
        },
        "maximum_retries_after_initial_attempt_per_register": {
          "const": 3
