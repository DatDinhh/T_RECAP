  "cdc_and_flow_rules": [
    "Core taps are valid-only and shall never return ready/backpressure into sample path, frame scheduler, FFT/IFFT, WOLA, or core metrics.",
    "Ready/valid is allowed between packetizers, packet FIFOs, and record builders.",
    "Multi-bit clock-domain crossings use async FIFO, snapshot/commit, Gray-coded counter protocol, or documented equivalent.",
    "Reset deassertion is synchronized per clock domain.",
    "HPS-written core-affecting controls use shadow/commit and safe-boundary update."
  ],
  "generation_notes": [
    "trecap_packet_type_e values shall be generated from packet_layouts.json, not duplicated manually.",
