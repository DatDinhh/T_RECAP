  "validation_rules": [
    "reserved_memory_geometry_matches_address_map_hps_runtime_and_platform_designer_sources",
    "dtsi_uses_exact_static_reg_and_no_map_without_reusable_or_shared_dma_pool",
    "device_tree_reservation_is_the_only_official_active_reservation_mechanism",
    "producer_pointer_has_no_HPS_write_path_and_advances_only_after_successful_DDR_commit",
    "consumer_pointer_changes_only_on_reset_storage_initialization_or_accepted_HPS_commit",
    "consumer_epoch_requires_zero_initial_commit_then_aligned_monotonic_bounded_commits",
    "wrap_required_space_includes_the_entire_physical_tail_and_normal_record",
    "wrap_record_zero_fills_tail_advances_by_tail_and_does_not_consume_sequence",
    "transport_reset_invalidates_configuration_and_consumer_epoch_before_explicit_reinitialization",
    "source_evidence_must_not_be_reported_as_compiled_DTB_boot_runtime_simulation_or_hardware_evidence"
  ]
