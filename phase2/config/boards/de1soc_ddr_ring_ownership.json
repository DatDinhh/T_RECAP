    "source_checker": "scripts/check_ddr_ring_ownership.py"
  },
  "reserved_memory_contract": {
    "official_reservation_mechanism": "device_tree_reserved_memory_no_map",
    "official_mechanism_count": 1,
    "kernel_memory_limit_bootarg_is_active_alternative": false,
    "dtsi_label": "trecap_telemetry_ring",
    "dtsi_node_name": "trecap-ring@3e000000",
    "address_cells": 1,
    "size_cells": 1,
    "empty_ranges_property_required": true,
    "hps_physical_base": "0x000000003e000000",
    "fpga_visible_base": "0x000000003e000000",
    "size_bytes": 33554432,
    "end_exclusive": "0x0000000040000000",
    "guard_bytes": 64,
    "record_alignment_bytes": 64,
    "natural_alignment_bytes": 33554432,
    "no_map": true,
    "reusable": false,
    "shared_dma_pool": false,
    "linux_allocator_may_use_region": false,
    "must_be_present_in_fdt_before_linux_boot": true,
    "runtime_configfs_overlay_is_sufficient": false
  },
  "pointer_ownership_contract": {
    "pointer_width_bits": 64,
    "pointer_unit": "bytes",
    "pointer_model": "absolute_monotonic_with_epoch_reset",
    "physical_offset_rule": "off(p)=p&(R-1)",
    "valid_used_range_rule": "0<=W-Rd<=R",
    "producer_pointer": "W",
    "producer_owner": "FPGA_DDR_ring_writer_only",
    "producer_software_write_csr_permitted": false,
    "producer_hps_access": "atomic_snapshot_read_only",
    "producer_advances_only_after_all_record_ddr_writes_complete_successfully": true,
    "consumer_pointer": "Rd",
    "consumer_owner": "HPS_shadow_commit_only",
    "consumer_runtime_assignment_source": "accepted_RING_RD_COMMIT",
    "consumer_async_reset_storage_initializes_zero": true,
    "soft_reset_directly_assigns_consumer_pointer": false,
    "ring_config_commit_directly_assigns_consumer_pointer": false,
    "consumer_epoch_valid_required_for_write_admission": true,
    "consumer_epoch_invalidated_by": [
      "telemetry_soft_reset",
      "ring_config_commit",
      "external_transport_reset"
    ],
    "consumer_first_commit_in_epoch_must_equal_zero": true,
    "consumer_runtime_commit_alignment_bytes": 64,
    "consumer_runtime_commit_must_not_move_backward": true,
    "consumer_runtime_commit_must_not_exceed_producer": true,
    "consumer_runtime_commit_must_keep_used_within_ring": true,
    "ring_writer_enable_requires_ring_configured_and_consumer_epoch_valid": true,
    "normal_commit_consumes_sequence": true,
    "wrap_commit_consumes_sequence": false
  },
  "wrap_boundary_contract": {
    "header_bytes": 32,
    "normal_record_length_rule": "Lrec=align64(header_bytes+payload_bytes)",
    "normal_record_crosses_ring_end_permitted": false,
    "wrap_required_rule": "off(W)+Lrec>R",
    "tail_rule": "Ttail=R-off(W)",
    "required_free_space_without_wrap": "Lrec",
    "required_free_space_with_wrap": "Ttail+Lrec",
    "available_free_space_rule": "R-(W-Rd)-guard",
    "wrap_packet_type": "0x007f",
    "wrap_payload_bytes": 0,
    "wrap_effective_length_rule": "Ttail",
    "generic_normal_length_rule_applies_to_wrap": false,
    "wrap_minimum_tail_bytes": 64,
    "wrap_header_followed_by_zero_padding_through_ring_end": true,
    "wrap_commits_only_after_all_tail_writes_complete_successfully": true,
    "producer_advance_after_wrap_rule": "W=W+Ttail",
    "normal_record_after_wrap_starts_at_offset_zero": true,
    "wrap_sequence_field": 0,
    "wrap_consumes_pc_visible_sequence": false,
    "insufficient_required_space_drops_record": true,
    "insufficient_required_space_advances_producer": false
  },
  "transport_reset_contract": {
    "sequence_owner": "HPS_control_plane",
    "required_sequence": [
      "clear_telemetry_enable_and_ring_writer_enable",
      "wait_for_writer_idle",
      "pulse_telemetry_soft_reset_once",
      "write_ring_base_and_size",
      "pulse_ring_config_commit_while_disabled",
      "commit_Rd_zero_from_HPS",
      "verify_W_zero_snapshot",
      "enable_ring_writer_then_telemetry"
    ],
    "writer_idle_required_before_soft_reset": true,
    "soft_reset_resets_fpga_producer_and_sequence": true,
    "soft_reset_invalidates_ring_configuration": true,
    "soft_reset_invalidates_consumer_epoch": true,
    "ring_config_commit_resets_fpga_producer_and_sequence": true,
    "ring_config_commit_invalidates_consumer_epoch": true,
    "hps_commit_Rd_zero_required_after_config": true,
    "W_zero_snapshot_required_before_enable": true,
    "writer_state_after_complete_sequence": "idle_configured_W_zero_sequence_zero",
    "reader_state_after_complete_sequence": "epoch_valid_Rd_zero",
    "enable_before_complete_sequence_permitted": false
  },
  "evidence_policy": {
    "source_checker": "scripts/check_ddr_ring_ownership.py",
    "schema_file": "spec/schemas/de1soc_ddr_ring_ownership.schema.json",
