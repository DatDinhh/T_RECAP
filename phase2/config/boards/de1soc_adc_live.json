      {
        "top_port": "ADC_DIN",
        "package_pin": "PIN_AK4",
        "device_signal": "SDI",
        "direction": "fpga_output"
      },
      {
        "top_port": "ADC_DOUT",
        "package_pin": "PIN_AK3",
        "device_signal": "SDO",
        "direction": "fpga_input"
      },
