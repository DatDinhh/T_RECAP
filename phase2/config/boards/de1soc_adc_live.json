    "command_bit_order": [
      "S/D",
      "O/S",
      "S1",
      "S0",
      "UNI",
      "SLP"
    ],
    "operating_mode": "single_ended_unipolar_awake",
    "sleep_bit_always_zero": true,
    "sleep_wakeup_delay_applicable": false,
    "unsupported_input_mode_polarity_or_sleep_command": "reject_set_protocol_error_no_transaction",
    "command_formula": "{1,channel[0],channel[2],channel[1],1,0}",
    "channel_commands": [
      {
        "channel": 0,
        "command_binary": "100010",
        "command_hex": "0x22"
      },
      {
        "channel": 1,
        "command_binary": "110010",
        "command_hex": "0x32"
      },
      {
        "channel": 2,
        "command_binary": "100110",
        "command_hex": "0x26"
      },
      {
        "channel": 3,
        "command_binary": "110110",
        "command_hex": "0x36"
      },
      {
        "channel": 4,
        "command_binary": "101010",
        "command_hex": "0x2a"
      },
      {
        "channel": 5,
        "command_binary": "111010",
        "command_hex": "0x3a"
      },
      {
        "channel": 6,
        "command_binary": "101110",
        "command_hex": "0x2e"
      },
      {
        "channel": 7,
        "command_binary": "111110",
        "command_hex": "0x3e"
      }
