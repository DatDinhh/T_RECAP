    "serial_command_bits": 6,
    "result_bit_order": "B11_to_B0_MSB_first",
    "sdo_transition_edge": "B11_valid_after_conversion_then_B10_to_B0_change_after_falling_ADC_SCLK",
    "sdo_capture_event": "fabric_clock_event_that_raises_ADC_SCLK_after_DOUT_synchronizer",
    "sdi_capture_edge_at_device": "rising_ADC_SCLK",
