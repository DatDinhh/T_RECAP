    "default_channel": 0,
    "default_command_binary": "100010",
    "board_channel_source": "sw_sync[6:4]",
    "channel_latch_point": "entry_to_TSRC_ADC_LIVE",
    "channel_stable_for_source_epoch": true,
    "channel_change_requires_leave_and_reenter": true,
    "command_shifted_during_result_read_configures_next_conversion": true,
    "first_result_after_reset_enable_abort_or_command_change": "discard",
    "sample_valid_requires_result_for_current_primed_command": true
  },
  "sample_format_contract": {
    "device_output_format": "unsigned_straight_binary",
    "raw_code_min": 0,
    "raw_code_max": 4095,
    "default_zero_code": 2048,
    "center_rule": "signed(raw_code)-2048",
    "centered_min": -2048,
    "centered_max": 2047,
    "core_sample_width_bits": 12,
    "adapter_scale_rule": "unsigned_midscale_subtract_then_signed_rnd_shr_Badc_minus_N",
    "dc_block_enabled_by_profile": false,
    "raw_sample_counter_width_bits": 64,
    "raw_sample_counter_arithmetic": "saturating_unsigned",
    "raw_sample_counter_event": "published_eligible_current_configuration_sample",
    "raw_sample_counter_clear": "hard_reset_only"
