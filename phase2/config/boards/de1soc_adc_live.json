  "sampling_contract": {
    "continuous_sample_rate_hz": 100000,
    "device_max_sample_rate_hz": 500000,
    "scheduler_kind": "exact_average_fractional_phase_accumulator",
    "scheduler_fabric_cycles_per_request": 500,
    "scheduler_interval_jitter_fabric_cycles_at_frozen_rate": 0,
