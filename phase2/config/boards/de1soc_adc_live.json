  "fault_contract": {
    "request_overrun_sticky_event": "scheduler_or_manual_request_attempt_occurs_during_reentry_recovery_or_while_protocol_state_not_idle",
    "protocol_error_sticky_event": "illegal_state_or_unsupported_protocol_configuration_or_unsupported_runtime_command",
    "clear_sticky_input": "clear_sticky_i",
