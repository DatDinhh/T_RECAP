    "maximum_device_sample_rate_hz": 500000,
    "serial_interface": "SPI_MICROWIRE_compatible_four_wire",
    "board_input_range_volts": "0_to_4.096",
    "io_standard": "3.3-V LVTTL",
    "pins": [
      {
        "top_port": "ADC_CS_N",
        "package_pin": "PIN_AJ4",
        "device_signal": "CONVST",
        "direction": "fpga_output"
