    "reentry_recovery_cycles_after_enable_or_abort": 92,
    "reentry_recovery_time_ns": 1840,
    "all_timing_parameters_checked_with_wide_cross_multiplied_arithmetic": true,
    "unsupported_well_formed_parameter_configuration_behavior": "fail_closed_idle_pins_no_requests_no_samples",
    "degenerate_zero_width_parameter_overrides_are_outside_module_abi": true
