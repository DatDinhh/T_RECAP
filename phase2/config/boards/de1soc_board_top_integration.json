    "conversion_start": "short_active_high_CONVST_pulse_idle_low",
    "minimum_post_convst_wait_us": "1.6",
    "serial_data_bits_per_result": 12,
    "next_configuration_bits": 6,
    "configuration_source": "sw_sync[6:4]",
    "configuration_latch_point": "entry_to_TSRC_ADC_LIVE",
    "configuration_stable_for_active_source_epoch": true,
