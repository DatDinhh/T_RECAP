  <planned_instances>
    <instance name="clk_0" kind="clock_source" role="50 MHz fabric clock source">
      <parameter name="clockFrequency" value="50000000" />
      <parameter name="clockFrequencyKnown" value="true" />
      <parameter name="resetSynchronousEdges" value="NONE" />
      <export name="clk_50" internal="clk_0.clk_in" kind="clock" direction="end" />
      <export name="reset_n" internal="clk_0.clk_in_reset" kind="reset" direction="end" />
    </instance>
    <instance name="hps_0" kind="altera_hps" version="20.1" role="Cyclone V HPS boundary; TSV freezes 520 values, applies 476, and classifies 44 as tool-derived readback-only">
      <parameter name="EMAC1_Mode" value="RGMII" />
      <parameter name="EMAC1_PinMuxing" value="HPS I/O Set 0" />
      <parameter name="F2SDRAM_Type" value="Avalon-MM Bidirectional" />
      <parameter name="F2SDRAM_Width" value="64" />
      <parameter name="HARD_EMIF" value="true" />
      <parameter name="HHP_HPS" value="true" />
      <parameter name="LWH2F_Enable" value="true" />
      <parameter name="MPU_EVENTS_Enable" value="false" />
      <parameter name="SDIO_Mode" value="4-bit Data" />
      <parameter name="SDIO_PinMuxing" value="HPS I/O Set 0" />
      <parameter name="UART0_Mode" value="No Flow Control" />
      <parameter name="UART0_PinMuxing" value="HPS I/O Set 0" />
      <parameter name="USB1_Mode" value="SDR" />
      <parameter name="USB1_PinMuxing" value="HPS I/O Set 0" />
      <export name="hps_io" internal="hps_0.hps_io" kind="conduit" direction="end" />
      <export name="memory" internal="hps_0.memory" kind="conduit" direction="end" />
      <export name="h2f_reset" internal="hps_0.h2f_reset" kind="reset" direction="start" />
    </instance>
    <instance name="trecap_csr_bridge" kind="altera_avalon_mm_bridge" version="20.1" role="32-bit, 21-bit byte-addressed CSR boundary">
      <parameter name="ADDRESS_UNITS" value="SYMBOLS" />
      <parameter name="ADDRESS_WIDTH" value="21" />
      <parameter name="DATA_WIDTH" value="32" />
      <parameter name="LINEWRAPBURSTS" value="0" />
      <parameter name="MAX_BURST_SIZE" value="1" />
      <parameter name="MAX_PENDING_RESPONSES" value="1" />
      <parameter name="PIPELINE_COMMAND" value="0" />
      <parameter name="PIPELINE_RESPONSE" value="0" />
      <parameter name="SYMBOL_WIDTH" value="8" />
      <parameter name="USE_AUTO_ADDRESS_WIDTH" value="0" />
      <parameter name="USE_RESPONSE" value="1" />
      <export name="trecap_csr_lw_master" internal="trecap_csr_bridge.m0" kind="avalon" direction="start" />
    </instance>
    <instance name="trecap_f2h_sdram_bridge" kind="altera_avalon_mm_bridge" version="20.1" role="64-bit, 32-bit byte-addressed FPGA-to-HPS SDRAM boundary">
      <parameter name="ADDRESS_UNITS" value="SYMBOLS" />
      <parameter name="ADDRESS_WIDTH" value="32" />
      <parameter name="DATA_WIDTH" value="64" />
      <parameter name="LINEWRAPBURSTS" value="0" />
      <parameter name="MAX_BURST_SIZE" value="1" />
      <parameter name="MAX_PENDING_RESPONSES" value="1" />
      <parameter name="PIPELINE_COMMAND" value="1" />
      <parameter name="PIPELINE_RESPONSE" value="1" />
      <parameter name="SYMBOL_WIDTH" value="8" />
      <parameter name="USE_AUTO_ADDRESS_WIDTH" value="0" />
      <parameter name="USE_RESPONSE" value="0" />
      <export name="trecap_f2h_sdram0" internal="trecap_f2h_sdram_bridge.s0" kind="avalon" direction="end" />
    </instance>
  </planned_instances>

  <planned_connections>
    <connection source="clk_0.clk" sink="hps_0.f2h_sdram0_clock" role="hps_bridge_clock" />
    <connection source="clk_0.clk" sink="hps_0.h2f_axi_clock" role="hps_bridge_clock" />
    <connection source="clk_0.clk" sink="hps_0.f2h_axi_clock" role="hps_bridge_clock" />
    <connection source="clk_0.clk" sink="hps_0.h2f_lw_axi_clock" role="hps_bridge_clock" />
    <connection source="clk_0.clk" sink="trecap_csr_bridge.clk" role="typed_bridge_clock" />
    <connection source="clk_0.clk_reset" sink="trecap_csr_bridge.reset" role="typed_bridge_reset" />
    <connection source="hps_0.h2f_lw_axi_master" sink="trecap_csr_bridge.s0" role="csr_bridge_upstream" baseAddress="0x00000000" />
    <connection source="clk_0.clk" sink="trecap_f2h_sdram_bridge.clk" role="typed_bridge_clock" />
    <connection source="clk_0.clk_reset" sink="trecap_f2h_sdram_bridge.reset" role="typed_bridge_reset" />
    <connection source="trecap_f2h_sdram_bridge.m0" sink="hps_0.f2h_sdram0_data" role="f2h_sdram_bridge_downstream" baseAddress="0x00000000" />
  </planned_connections>

  <integration_contract>
    <rule id="no_fpga_ethernet" value="Ethernet is HPS-owned. FPGA fabric shall not implement UDP or Ethernet MAC here." />
    <rule id="no_signal_processing_on_hps" value="HPS may transport and control only. FFT, IFFT, WOLA, mask, and error computation remain in FPGA fabric." />
    <rule id="csr_constants" value="CSR offsets come from generated headers derived from spec/generated/csr_map.json." />
    <rule id="csr_full_decode" value="The 4 KiB CSR subwindow at offset zero shall be fully decoded inside the 2 MiB lightweight aperture; unused addresses must not alias the CSR bank." />
    <rule id="ring_base" value="RING_BASE is FPGA-visible bus address, not Linux userspace virtual address." />
    <rule id="platform_generated_policy" value="Generated Platform Designer HDL shall not be hand-edited." />
    <rule id="source_freeze_boundary" value="This bootstrap records the source-implemented typed bridge graph; Quartus normalization, generation, compile, SOPCINFO review, and hardware evidence remain required before signoff." />
  </integration_contract>
</system>
