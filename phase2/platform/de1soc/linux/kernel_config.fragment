# Linux 6.12 platform ABI; merge with socfpga_defconfig.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_OF=y
CONFIG_OF_RESERVED_MEM=y
CONFIG_GPIO_DWAPB=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_CDEV=y
CONFIG_MODULES=y
CONFIG_DEVMEM=y
CONFIG_STRICT_DEVMEM=n
CONFIG_FPGA=y
CONFIG_FPGA_MGR_SOCFPGA=y
CONFIG_FPGA_BRIDGE=y
CONFIG_SOCFPGA_FPGA_BRIDGE=y
