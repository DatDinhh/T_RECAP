        }
      ],
      "notes": [
        {
          "title": "A finite-file application",
          "body": "RF capture hardware has already converted the carrier to baseband I/Q. This profile processes a saved file. It does not directly sample the 433.92 MHz carrier or establish live throughput.",
          "rect": [
            80,
            950,
            800,
            135
          ],
          "tone": "gray"
        },
        {
          "title": "Shared DSP, distinct interface",
          "body": "TRF1 identifies raw I/Q input. The audio TSH2 image expects PCM. These are separate application images using the same numerical core.",
          "rect": [
            920,
            950,
            800,
            135
          ],
          "tone": "blue"
        }
      ],
      "panels": []
    },
    {
      "number": 2,
      "title": "How two I/Q components become one real stream",
      "subtitle": "The conversion changes the representation and sample count. It preserves both components subject to filtering and fixed-point precision.",
      "slug": "02-signal-representation",
      "source_ids": [
        "R01",
        "R02",
        "R03",
        "R04"
      ],
      "nodes": [
        {
          "id": "cu8",
          "title": "Unsigned I and Q",
          "body": [
            "Each byte spans 0 to 255",
            "A pair describes one complex sample"
          ],
          "rect": [
            80,
            280,
            340,
            190
          ],
          "tone": "mint",
          "code": ""
        },
        {
          "id": "center",
          "title": "Center around zero",
          "body": [
            "d = 2*b - 255",
            "Signed9 history values",
            "No per-file peak normalization"
          ],
          "rect": [
            510,
            280,
            340,
            190
          ],
          "tone": "mint",
          "code": ""
        },
        {
          "id": "fir",
          "title": "Interpolate by four",
          "body": [
            "81-tap interpolation filter",
            "Four polyphase branches",
            "Suppress upsampling images"
          ],
          "rect": [
            940,
            280,
            340,
            190
          ],
          "tone": "lav",
          "code": "",
          "bodySize": 13.8
        },
        {
          "id": "mix",
          "title": "Shift to real low IF",
          "body": [
            "x[m] = Iu[m] cos(pi*m/2)",
            "           - Qu[m] sin(pi*m/2)",
            "IF center = Fs_IQ"
          ],
          "rect": [
            1370,
            280,
            350,
            190
          ],
          "tone": "lav",
          "code": "",
          "bodySize": 13.2
        },
        {
          "id": "gain",
          "title": "Gain and quantization",
          "body": [
            "Latch gain shift 0 through 3",
            "Round once, ties away from zero",
            "Saturate to signed12 and count clips"
          ],
          "rect": [
            1370,
            650,
            350,
            220
          ],
          "tone": "lav",
          "code": "",
          "bodySize": 14.4
        },
        {
          "id": "real",
          "title": "Real signed12 samples",
          "body": [
            "4 outputs per input pair",
            "Sample rate = 4*Fs_IQ",
            "Same RF segment duration"
          ],
          "rect": [
            940,
            650,
            340,
            220
          ],
          "tone": "mint",
          "code": "",
          "bodySize": 14.4
        },
        {
          "id": "existing",
          "title": "Shared core input",
          "body": [
            "Pad only after the valid RF segment",
            "FFT -> threshold -> IFFT/WOLA",
            "TSP1 contains the retained powers"
          ],
          "rect": [
            510,
            650,
            340,
            220
          ],
          "tone": "blue",
          "code": "",
          "bodySize": 14.4
        },
        {
          "id": "example",
          "title": "Example conversion",
          "body": [
            "250 kpair/s complex input",
            "1 Msamples/s real output",
            "Center the real IF at 250 kHz"
          ],
          "rect": [
            80,
            650,
            340,
            220
          ],
          "tone": "sand",
          "code": "",
          "bodySize": 14.4
        }
      ],
      "edges": [
        {
          "from": "cu8",
          "to": "center",
          "fromPort": "right",
          "toPort": "left",
          "via": [],
          "kind": "data"
        },
        {
          "from": "center",
          "to": "fir",
          "fromPort": "right",
          "toPort": "left",
          "via": [],
          "kind": "data"
        },
        {
          "from": "fir",
          "to": "mix",
          "fromPort": "right",
          "toPort": "left",
          "via": [],
          "kind": "data"
        },
        {
          "from": "mix",
          "to": "gain",
          "fromPort": "bottom",
          "toPort": "top",
          "via": [],
          "kind": "data"
        },
        {
          "from": "gain",
          "to": "real",
          "fromPort": "left",
          "toPort": "right",
          "via": [],
          "kind": "data"
        },
        {
          "from": "real",
          "to": "existing",
          "fromPort": "left",
          "toPort": "right",
          "via": [],
          "kind": "data"
        }
      ],
      "notes": [
        {
          "title": "Four-phase mixer",
          "body": "+Iu[0], -Qu[1], -Iu[2], +Qu[3], then repeat the signs. These are interpolated values at successive output times, not four copies of one raw pair.",
          "rect": [
            80,
            510,
            1200,
            100
          ],
          "tone": "rose",
          "bodySize": 13.5
        },
        {
          "title": "What the factor four means",
          "body": "65,536 pairs become 262,144 real samples for the same 0.262144 s recording. The 1 MHz sample interpretation is not a measured hardware processing rate.",
          "rect": [
            80,
            950,
            800,
            135
          ],
          "tone": "gray"
        },
        {
          "title": "What the FIR does",
          "body": "This fixed interpolation filter supports format conversion. The adjustable THR2 decision remains in the shared spectral processing core.",
          "rect": [
            920,
            950,
            800,
            135
          ],
          "tone": "blue"
        }
      ],
      "panels": []
    },
    {
      "number": 3,
      "title": "Inside the I/Q adapter: reused arithmetic hardware",
      "subtitle": "One multiplier and accumulator compute one polyphase result at a time. The four output phases reuse the same datapath.",
      "slug": "03-adapter-hardware",
      "source_ids": [
        "R01",
        "R03"
      ],
      "nodes": [
        {
          "id": "history",
          "title": "I and Q history banks",
          "body": [
            "21 signed9 samples in each bank",
            "Shift once per accepted input pair",
            "Exact signed-zero tail samples"
          ],
          "rect": [
            80,
            280,
            430,
            215
          ],
          "tone": "mint",
          "code": "hist_i[0:20], hist_q[0:20]"
        },
        {
          "id": "select",
          "title": "Select the history bank",
          "body": [
            "Even phase: I history",
            "Odd phase: Q history",
            "Select position tap_q"
          ],
          "rect": [
            625,
            280,
            430,
            215
          ],
          "tone": "blue",
          "code": "history_value"
        },
        {
          "id": "mul",
          "title": "One signed multiplier",
          "body": [
            "Signed9 sample x signed18 coefficient",
            "Signed27 product",
            "Sign-extend before accumulation"
          ],
          "rect": [
            1170,
            280,
            550,
            215
          ],
          "tone": "lav",
          "code": "product = history_value * coefficient"
        },
        {
          "id": "coeff",
          "title": "Fixed coefficient table",
          "body": [
            "Index = 4*tap_q + phase_q",
            "81 coefficients with 16 fractional bits",
            "Positions 81, 82 and 83 return zero"
          ],
          "rect": [
            80,
            650,
            430,
            215
          ],
          "tone": "blue",
          "code": "rf_coefficients.svh"
        },
        {
          "id": "control",
          "title": "Phase and tap counters",
          "body": [
            "phase_q: 0 through 3",
            "tap_q: 0 through 20",
            "21 MAC clock cycles per phase"
          ],
          "rect": [
            625,
            650,
            430,
            215
          ],
          "tone": "sand",
          "code": ""
        },
        {
          "id": "acc",
          "title": "Accumulator and output arithmetic",
          "body": [
            "Signed36 sum with no intermediate rounding",
            "Negate phases 1 and 2",
            "Gain, final rounding and signed12 saturation"
          ],
          "rect": [
            1170,
            650,
            550,
            215
          ],
          "tone": "lav",
          "code": "acc_q -> mixed -> rounded -> quantized"
        }
      ],
      "edges": [
        {
          "from": "history",
          "to": "select",
          "fromPort": "right",
          "toPort": "left",
          "via": [],
          "kind": "data"
        },
        {
          "from": "select",
          "to": "mul",
          "fromPort": "right",
          "toPort": "left",
          "via": [],
          "kind": "data"
        },
        {
          "from": "mul",
          "to": "acc",
          "fromPort": "bottom",
          "toPort": "top",
          "via": [],
          "kind": "data",
          "label": "accumulate products",
          "labelAt": [
            1450,
            565
          ]
        },
        {
          "from": "coeff",
          "to": "mul",
          "fromPort": "top",
          "toPort": "bottom",
          "via": [
            [
              295,
              550
            ],
            [
              1230,
              550
            ]
          ],
          "kind": "data",
          "toOffset": -215,
          "label": "coefficient",
          "labelAt": [
            780,
            545
          ]
        },
        {
          "from": "control",
          "to": "select",
          "fromPort": "top",
          "toPort": "bottom",
          "via": [],
          "kind": "control"
        },
        {
          "from": "control",
          "to": "coeff",
          "fromPort": "left",
          "toPort": "right",
          "via": [],
          "kind": "control"
        },
        {
          "from": "control",
          "to": "acc",
          "fromPort": "right",
          "toPort": "left",
          "via": [],
          "kind": "control"
        }
      ],
      "notes": [
        {
          "title": "Why no sine/cosine multiplier?",
          "body": "At a quarter-rate IF, the oscillator values are only 0, +1 and -1. Selecting I or Q and changing the sign performs the mixing step.",
          "rect": [
            80,
            950,
            800,
            135
          ],
          "tone": "rose"
        },
        {
          "title": "Resource and rate tradeoff",
          "body": "The shared MAC reduces arithmetic hardware. It requires multiple clocks for each sample and stalls when the downstream core cannot accept data.",
          "rect": [
            920,
            950,
            800,
            135
          ],
          "tone": "gray"
        }
      ],
      "panels": []
    },
    {
      "number": 4,
      "title": "Finite-file geometry and completion ownership",
      "subtitle": "The adapter, padding wrapper, numerical core and host each have a different completion boundary.",
      "slug": "04-finite-file-completion",
      "source_ids": [
        "R01",
        "R02",
        "R05",
        "R10",
        "R11",
        "R07"
      ],
      "nodes": [
        {
          "id": "pairs",
          "title": "Admitted RF file",
          "body": [
            "N pairs with 1 <= N <= 96,000",
            "Each accepted pair enters once",
            "Configuration is fixed for the run"
          ],
          "rect": [
            80,
            280,
            450,
            200
          ],
          "tone": "mint",
          "code": ""
        },
        {
          "id": "fir",
          "title": "FIR boundary handling",
          "body": [
            "Zero initial history",
            "Discard 40 causal output samples",
            "Append ten exact-zero input pairs"
          ],
          "rect": [
            675,
            280,
            450,
            200
          ],
          "tone": "lav",
          "code": ""
        },
        {
          "id": "valid",
          "title": "Valid RF prefix",
          "body": [
            "Exactly 4*N real signed12 samples",
            "Indices 0 through 4*N - 1",
            "Adapter DONE on its last transfer"
          ],
          "rect": [
            1270,
            280,
            450,
            200
          ],
          "tone": "mint",
          "code": ""
        },
        {
          "id": "padding",
          "title": "Transaction padding",
          "body": [
            "Append zeros to 384,000 samples",
            "Wrapper last marks sample 383,999",
            "These zeros are not captured RF data"
          ],
          "rect": [
            1270,
            650,
            450,
            220
          ],
          "tone": "blue",
          "code": ""
        },
        {
          "id": "core",
          "title": "Shared finite core",
          "body": [
            "3,001 analysis frames",
            "384,512 reconstructed Y samples",
            "Drain spectral records and WOLA tail"
          ],
          "rect": [
            675,
            650,
            450,
            220
          ],
          "tone": "lav",
          "code": ""
        },
        {
          "id": "done",
          "title": "Production DONE, then host drain",
          "body": [
            "Check every input and output count",
            "Require empty raw queue and prefetch",
            "Host still drains remaining output FIFOs"
          ],
          "rect": [
            80,
            650,
            450,
            220
          ],
          "tone": "sand",
          "code": "",
          "bodySize": 14.4
        }
      ],
      "edges": [
        {
          "from": "pairs",
          "to": "fir",
          "fromPort": "right",
          "toPort": "left",
          "via": [],
          "kind": "data"
        },
        {
          "from": "fir",
