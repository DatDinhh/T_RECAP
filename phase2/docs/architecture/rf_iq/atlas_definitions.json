  "plates": [
    {
      "number": 1,
      "title": "Recorded RF through the shared T-RECAP core",
      "subtitle": "TRF1 combines an FPGA I/Q frontend with the shared transform, threshold, reconstruction and spectral exporter.",
      "slug": "01-system",
      "source_ids": [
        "R01",
        "R02",
        "R05",
        "R07",
        "R10",
        "R13"
      ],
      "nodes": [
        {
          "id": "file",
          "title": "1. Recorded RF on the laptop",
          "body": [
            "CU8 file: I byte, then Q byte",
            "N complex pairs with capture metadata",
            "Example: 65,536 pairs at 250 kpair/s"
          ],
          "rect": [
            80,
            280,
            480,
            230
          ],
          "tone": "mint",
          "code": ""
        },
        {
          "id": "hps",
          "title": "2. HPS Linux RAM and ARM client",
          "body": [
            "Receive the raw file without DSP",
            "Check TRF1 identity and configuration",
            "Feed I/Q and drain both output FIFOs"
          ],
          "rect": [
            660,
            280,
            480,
            230
          ],
          "tone": "sand",
          "code": "trf1_client.c"
        },
        {
          "id": "rf",
          "title": "3. FPGA I/Q input frontend",
          "body": [
            "CU8 centering and 4x interpolation",
            "Quarter-rate mixing to real low IF",
            "Signed12 output and finite-file padding"
          ],
          "rect": [
            1240,
            280,
            480,
            230
          ],
          "tone": "mint",
          "code": "trecap_rf_file_source"
        },
        {
          "id": "dsp",
          "title": "4. Shared FPGA processing",
          "body": [
            "256-point FFT and tunable threshold",
            "IFFT/WOLA reconstruction",
            "Separate TSP1 spectral-power exporter"
          ],
          "rect": [
            1240,
            650,
            480,
            230
          ],
          "tone": "lav",
          "code": "trecap_pcm_stream_top"
        },
        {
          "id": "results",
          "title": "5. HPS result collection",
          "body": [
            "Complete Y samples and TSP1 packets",
            "Counts, clipping and source identity",
            "Return the captured results archive"
          ],
          "rect": [
            660,
            650,
            480,
            230
          ],
          "tone": "sand",
          "code": ""
        },
        {
          "id": "analysis",
          "title": "6. Laptop inspection",
          "body": [
            "Compare captured data with reference",
            "Plot waveform and spectral changes",
            "Optional CPU-side RF payload decoding"
          ],
          "rect": [
            80,
            650,
            480,
            230
          ],
          "tone": "blue",
          "code": ""
        }
      ],
