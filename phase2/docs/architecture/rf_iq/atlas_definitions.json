        }
      ],
      "notes": [
        {
          "title": "Example, N = 65,536",
          "body": "262,144 valid RF samples + 121,856 transaction-padding samples = 384,000 core input samples. Plotting and RF statistics must identify the valid segment.",
          "rect": [
            80,
            950,
            800,
            135
          ],
          "tone": "mint"
        },
        {
          "title": "Three different tails",
          "body": "FIR tail pairs complete conversion. Transaction padding satisfies the core geometry. Analysis flush and WOLA tail complete the finite DSP schedule.",
          "rect": [
            920,
            950,
            800,
            135
          ],
          "tone": "gray"
        }
      ],
