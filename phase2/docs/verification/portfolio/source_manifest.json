  "figures": [
    {
      "local": "figures/topology.pdf",
      "source_artifact_id": "archive:workspace/work/verification_20261017_release/figures/static04/verification_topology.pdf",
      "original_sha256": "c080201e3f6afda1cfa3eacd5e599dc3a7c15f82d5e6be5902677ba494f1a139",
      "published_sha256": "c080201e3f6afda1cfa3eacd5e599dc3a7c15f82d5e6be5902677ba494f1a139",
      "transformation": "none; vector PDF copied byte-for-byte",
      "caption": "Conceptual verification and physical-capture boundaries. All fresh board captures use frozen registered expected outputs. The repaired reference was independently qualified on primitives and short vectors, and full-length threshold-zero output was checked against unchanged frozen gold. This does not imply fresh regeneration of all 58 board expectations or internal FPGA-stage timing instrumentation. The nominal/constrained active board fabric clock is CLOCK_50 at 50 MHz (20 ns)."
    },
    {
      "local": "figures/rounding.pdf",
      "source_artifact_id": "archive:workspace/work/verification_20261017_release/figures/static04/rounding_boundary.pdf",
      "original_sha256": "89d49856e33aaec70be74d34e8122b51a4c9c5885245fb13ec066e3a81c1f3c1",
      "published_sha256": "89d49856e33aaec70be74d34e8122b51a4c9c5885245fb13ec066e3a81c1f3c1",
      "transformation": "none; vector PDF copied byte-for-byte",
      "caption": "Four retained binary-response witnesses. The repaired API agrees with exact integer expectations at shifts63 and64, including both half ties and INT64_MIN. Old executable responses are retained as negative controls."
    },
    {
      "local": "figures/handshake.pdf",
      "source_artifact_id": "archive:workspace/work/verification_20261017_release/figures/traces02/rtl_handshake_backpressure.pdf",
      "original_sha256": "12504f60afa2cfc28618ee1c38249fce16f29e67f4a893f629b5478a496a7a33",
      "published_sha256": "12504f60afa2cfc28618ee1c38249fce16f29e67f4a893f629b5478a496a7a33",
      "transformation": "none; vector PDF copied byte-for-byte",
      "caption": "State changes parsed from the first recorded window of the full-length dense threshold-zero simulation. Orange shading marks observed valid=1, ready=0. The conjunction lane is a derived logic level, not a transaction count."
    },
    {
      "local": "figures/reset.pdf",
      "source_artifact_id": "archive:workspace/work/verification_20261017_release/figures/traces02/rtl_reset_response.pdf",
      "original_sha256": "fc320d96631dcac4b2d7035088b14d421336078c9ba49f8439a6f445166b3593",
      "published_sha256": "fc320d96631dcac4b2d7035088b14d421336078c9ba49f8439a6f445166b3593",
      "transformation": "none; vector PDF copied byte-for-byte",
      "caption": "Four recorded cancellation excerpts: clear and hard reset during FFT compute wait and WOLA add-write. The separate simulation scoreboard verified quiet cancellation and exact fresh-epoch recovery. Only short cancellation excerpts are plotted; full recovery epochs were outside the recorded VCD windows."
    },
    {
      "local": "figures/fullrun.pdf",
      "source_artifact_id": "archive:workspace/work/verification_20261017_release/figures/startup03/rtl_fullrun_startup.pdf",
      "original_sha256": "944a5156eae78b004df626d81996d4b35da18044d0ba38dee5493ef095058be9",
      "published_sha256": "944a5156eae78b004df626d81996d4b35da18044d0ba38dee5493ef095058be9",
      "transformation": "none; vector PDF copied byte-for-byte",
      "caption": "Observed source/output indices, core/exported frame counts and input FIFO occupancy from the startup window of the full-length dense threshold-zero simulation. The retained window ends at absolute simulation time 203.880 us, after the first 20,000 epoch cycles plus setup. This plot is a startup excerpt only; it does not show the duration or completion of the full 384,000-input run. Bus values come directly from the retained VCD prefix. Presented indices are not cumulative handshake counts. The simulation uses a 10 ns clock; the active physical CLOCK_50 period is 20 ns."
    },
    {
      "local": "figures/audio.pdf",
      "source_artifact_id": "archive:workspace/work/verification_20261017_release/figures/hardware03/flute_waveform_comparison.pdf",
      "original_sha256": "f266bbffda660930e14d3caf6849c0466410f52cf055881395eac37c70b2bed7",
      "published_sha256": "f266bbffda660930e14d3caf6849c0466410f52cf055881395eac37c70b2bed7",
      "transformation": "none; vector PDF copied byte-for-byte",
      "caption": "Fresh DE1-SoC flute reconstruction for thresholds 0, 10^8, 10^9, 10^10, and 10^11. The left panels retain the minimum and maximum of every 96-sample (2 ms) block across the complete 8 s clip. Right panels show every sample in the same 20 ms window (1.180 to 1.200 s), chosen as the loudest nonoverlapping input-only window. Plotted outputs are epochs 49, 51, 53, 55, and 57; the second repeat at each threshold is byte-identical. All panels use the same signed12 LSB scale and remove exactly 384 leading returned samples."
    },
    {
      "local": "figures/quality.pdf",
      "source_artifact_id": "archive:workspace/work/verification_20261017_release/figures/hardware03/flute_error_agreement.pdf",
      "original_sha256": "a0c252a2132954004420bb7b1a709fb01f4c8129badc3be9809063fd4259fb6f",
      "published_sha256": "a0c252a2132954004420bb7b1a709fb01f4c8129badc3be9809063fd4259fb6f",
      "transformation": "none; vector PDF copied byte-for-byte",
      "caption": "Left: normalized RMS difference from the original input over 384,000 aligned samples, computed as 100*sqrt(sum((Y[n+384]-x[n])^2)/sum(x[n]^2)). Right: maximum absolute difference from the registered threshold-specific reference over every one of the 384,512 returned samples. All reference differences are exactly zero in both fresh repeats. Exact reference agreement does not imply zero signal distortion at nonzero thresholds."
    },
    {
      "local": "figures/packet_sizes.pdf",
      "source_artifact_id": "archive:workspace/work/verification_20261017_release/figures/hardware03/flute_packet_sizes.pdf",
      "original_sha256": "dcb66bf0dbb6d4b74034181209ecf9631a9a7d1f91cf988fd1dff68ad8982374",
      "published_sha256": "dcb66bf0dbb6d4b74034181209ecf9631a9a7d1f91cf988fd1dff68ad8982374",
      "transformation": "none; vector PDF copied byte-for-byte",
      "caption": "Captured sparse TSP1 byte counts, including frame headers, across 3,001 frames. Reduction is measured against the registered compact dense TSP1 file, 2,856,952 bytes (952 bytes/frame), and not against WAV or PCM input size. At threshold zero the sparse representation is larger than the compact dense representation. Both fresh repeats produced identical bytes."
    }
