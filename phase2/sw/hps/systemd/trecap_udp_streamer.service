# SPDX-License-Identifier: MIT
# T-RECAP Phase 2 HPS UDP streamer systemd unit.
# File class: [1] hand-written HPS runtime service.
#
# This unit is for the installed HPS runtime, not for source-tree development.
# Build, install the kernel platform driver, and install both units using
# platform/de1soc/linux/README.md. Enable after the intended DTB and FPGA image
# are installed; source checkout and installation do not start this service.
#
# Runtime customization belongs in a systemd drop-in or in:
#   /etc/default/trecap_udp_streamer
#
# Default launch policy is STATUS-only. That is intentional. Full WAVE/SPEC/
# METRICS should be enabled only after CSR, DDR ring, UDP, and PC parser bring-up
# are operational. Example full-demo override:
#
#   TRECAP_PROFILE=--full-demo
#   TRECAP_EXTRA_ARGS="--wave-decim 2 --spec-mode 1 --spec-shift 16"
#
# Network setup is intentionally not performed by this service. Configure the HPS
# Ethernet interface through the board OS or run sw/hps/scripts/setup_static_ip.sh
# once during bring-up. This service assumes Ethernet is already online.

[Unit]
Description=T-RECAP Phase 2 HPS DDR-ring UDP telemetry streamer
Documentation=file:/etc/trecap/trecap_hps_config.json
Wants=network-online.target
Requires=trecap_platform.service
After=local-fs.target network-online.target trecap_platform.service
ConditionPathExists=/usr/local/bin/trecap_udp_streamer
ConditionPathExists=/etc/trecap/trecap_hps_config.json
ConditionPathExists=/dev/mem
ConditionPathExists=/dev/trecap-ring
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=root
Group=root
UMask=0077
WorkingDirectory=/var/lib/trecap

# Installed by sw/hps/Makefile `install` target.
Environment=TRECAP_CONFIG=/etc/trecap/trecap_hps_config.json

# Safe Revision-G bring-up default: STATUS first. Override only after the
# STATUS-only path is proven on the board and PC parser.
Environment=TRECAP_PROFILE=--status-only
# Canonical policy comes from JSON: latch disabled, keep the process alive for
# diagnostic PING/STATUS, and require operator reset/reconfiguration to resume.
# A lab drop-in may set --stop-on-malformed; exit 3 is then never auto-restarted.
Environment=TRECAP_MALFORMED_POLICY=
Environment=TRECAP_EXTRA_ARGS=
EnvironmentFile=-/etc/default/trecap_udp_streamer

ExecStartPre=/usr/bin/test -x /usr/local/bin/trecap_udp_streamer
ExecStartPre=/usr/bin/test -r ${TRECAP_CONFIG}
ExecStartPre=/usr/bin/test -c /dev/mem
ExecStartPre=/usr/bin/test -c /dev/trecap-ring
ExecStartPre=/usr/local/bin/trecap_udp_streamer --config ${TRECAP_CONFIG} --dry-run --quiet
ExecStart=/usr/local/bin/trecap_udp_streamer --config ${TRECAP_CONFIG} $TRECAP_PROFILE $TRECAP_MALFORMED_POLICY $TRECAP_EXTRA_ARGS

Restart=on-failure
RestartSec=2s
RestartPreventExitStatus=3
TimeoutStartSec=30s
TimeoutStopSec=10s
KillSignal=SIGTERM
KillMode=control-group
SuccessExitStatus=0 130 143

StandardOutput=journal
StandardError=journal
SyslogIdentifier=trecap_udp_streamer

# systemd-managed writable locations. The streamer normally logs to journald;
# these directories are reserved for future runtime counters, crash notes, or
# operator captures without widening filesystem writes.
RuntimeDirectory=trecap
StateDirectory=trecap
LogsDirectory=trecap

# CSRs use /dev/mem; the reserved DDR aperture uses the read-only platform driver.
# The service retains root and raw-I/O capability for CSR ownership.
NoNewPrivileges=true
CapabilityBoundingSet=CAP_SYS_RAWIO
AmbientCapabilities=CAP_SYS_RAWIO
PrivateTmp=true
PrivateDevices=false
DevicePolicy=closed
DeviceAllow=/dev/mem rw
DeviceAllow=/dev/trecap-ring r
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Filesystem hardening. Runtime/config paths are kept narrow; source trees,
# generated headers, build products, and reference artifacts are not needed at
# service runtime.
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/trecap /usr/local/bin/trecap_udp_streamer
ReadWritePaths=/run/trecap /var/lib/trecap /var/log/trecap

# General service hardening. Do not add a broad SystemCallFilter yet; /dev/mem,
# mmap, and the exact DE1-SoC Linux image must be validated on hardware first.
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
SystemCallArchitectures=native
KeyringMode=private

# Long-demo accounting visible through systemctl status / systemd-cgtop.
CPUAccounting=true
MemoryAccounting=true
IOAccounting=true
IPAccounting=true

[Install]
WantedBy=multi-user.target
