# SPDX-License-Identifier: MIT
# T-RECAP Phase 2 root ignore policy.
# File class: [1] hand-written repository infrastructure.
#
# Important policy:
# - Do not ignore generated contract headers. They are intentionally committed.
# - Do not ignore frozen/provisional coefficient and vector artifacts under artifacts/.
# - Do ignore local simulator, Quartus, CMake, Python, capture, and Phase 1 root-dump files.

# -----------------------------------------------------------------------------
# OS/editor noise
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
desktop.ini
*~
*.swp
*.swo
*.bak
*.orig
*.rej
*.tmp
*.temp
*.log
.idea/
.vscode/
*.code-workspace

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.ipynb_checkpoints/
.cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# -----------------------------------------------------------------------------
# CMake / C / C++ local builds
# -----------------------------------------------------------------------------
/build*/
/cmake-build-*/
/install*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
CTestTestfile.cmake
DartConfiguration.tcl
Testing/
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.pdb
*.ilk
*.gcda
*.gcno
*.profraw
*.profdata

# -----------------------------------------------------------------------------
# Root run/output folders
# -----------------------------------------------------------------------------
/out/*
!/out/.gitkeep
/runs/*
!/runs/.gitkeep

# Reference-model local outputs after import. Keep the source package, not its
# developer machine state.
/sw/reference_model/.venv/
/sw/reference_model/build*/
/sw/reference_model/out/*
!/sw/reference_model/out/.gitkeep
/sw/reference_model/runs/*
!/sw/reference_model/runs/.gitkeep
/sw/reference_model/.pytest_cache/
/sw/golden/.venv/
/sw/golden/build*/
/sw/golden/out/*
!/sw/golden/out/.gitkeep
/sw/golden/runs/*
!/sw/golden/runs/.gitkeep
/sw/golden/.pytest_cache/

# -----------------------------------------------------------------------------
# HDL simulation outputs: ModelSim/Questa, Verilator, generic wave dumps
# -----------------------------------------------------------------------------
/work/
/work*/
/audio_work/
/adc_work/
/sim/work*/
transcript
vsim.wlf
*.wlf
*.vcd
*.fst
*.ghw
*.vpd
*.ucdb
*.vstf
modelsim.ini
*.mti
obj_dir/
verilator_build/
*.vlt

# -----------------------------------------------------------------------------
# Quartus / Intel FPGA generated output
# Keep project source files such as .qpf, .qsf, .sdc, .tcl, and .qsys. The
# current Step-3 policy regenerates SOPCINFO/QIP/vendor HDL locally.
# -----------------------------------------------------------------------------
/db/
/incremental_db/
/output_files/
/simulation/
*.rpt
*.summary
*.smsg
*.jdi
*.pin
*.sof
*.pof
*.jic
*.rbf
*.ekp
*.qws
*.qdf
*.qdz
*.qarlog
*.sld
*.sta.rpt
*.fit.rpt
*.asm.rpt
*.map.rpt
*.flow.rpt

# Quartus/Platform Designer generated folders that should be regenerated unless
# the project explicitly documents and whitelists specific generated HDL files.
platform/de1soc/qsys/*.sopcinfo
platform/de1soc/qsys/*/synthesis/
platform/de1soc/qsys/*/simulation/
platform/de1soc/qsys/*/testbench/
platform/de1soc/qsys/*/greybox_tmp/
platform/de1soc/qsys/*/submodules/

# -----------------------------------------------------------------------------
# HPS/Linux build and deployment local outputs
# -----------------------------------------------------------------------------
*.dtb
*.dtbo
*.ko
*.mod
*.mod.c
modules.order
Module.symvers
rootfs_overlay/
sdcard_image/
*.img
*.wic
*.tar.gz
*.tar.xz
*.zip

# Do not ignore the uploaded/reference zip if the team deliberately stores it
# under docs or a release archive. Ignore only accidental root-level zip dumps.
/*.zip

# -----------------------------------------------------------------------------
# PC dashboard local state
# -----------------------------------------------------------------------------
/sw/pc_dashboard/.venv/
/sw/pc_dashboard/.pytest_cache/
/sw/pc_dashboard/.mypy_cache/
/sw/pc_dashboard/.ruff_cache/
/sw/pc_dashboard/.streamlit/
/sw/pc_dashboard/.dash_cache/

# -----------------------------------------------------------------------------
# Telemetry captures are local by default; commit only curated captures by moving
# them to a named release folder and adjusting this rule deliberately.
# -----------------------------------------------------------------------------
/artifacts/telemetry_captures/*
!/artifacts/telemetry_captures/.gitkeep
*.pcap
*.pcapng

# -----------------------------------------------------------------------------
# Forbidden Phase 1 root dumps. After quarantine, these files are allowed under
# legacy/phase1/ because these patterns are anchored to the repo root.
# -----------------------------------------------------------------------------
/t_recap_demo_top.sv
/golden_model.cpp
/viz.py
/run.py
/x.memh
/y.memh
/sup.memh
/metrics.json
