/ref_model_phase1.sv
/golden_files_loader.sv
/x_stream_monitor.sv
/y_stream_monitor.sv
/pair_monitor.sv
/io_monitor.sv
/metrics_monitor.sv
/scoreboard_pairs.sv
/scoreboard_y_stream.sv
/scoreboard_metrics.sv
/cov_phase1.sv
/sva_phase1_bind.sv
/test_base.sv
/test_bypass_lossless.sv
/test_golden_thresh16.sv
/test_threshold_sweep.sv
/test_clear_metrics_midrun.sv
/test_mode_switch_stress.sv

# -----------------------------------------------------------------------------
# Explicitly keep generated contract headers and source-of-truth artifacts.
# These negations protect against broad tool-output patterns above.
# -----------------------------------------------------------------------------
!rtl/include/generated/
!rtl/include/generated/*.sv
!sw/hps/include/generated/
!sw/hps/include/generated/*.h
!sw/pc_dashboard/generated/
!sw/pc_dashboard/generated/*.py
!sw/reference_model/generated/
!sw/reference_model/generated/*.py
!spec/generated/
!spec/generated/*.json
!filelists/
!filelists/*.f
!filelists/*.inc
!artifacts/coefficients/
!artifacts/coefficients/*.memh
!artifacts/coefficients/*.json
!artifacts/test_vectors/
!artifacts/test_vectors/**/*.memh
!artifacts/test_vectors/**/*.json
!artifacts/reference_outputs/
!artifacts/reference_outputs/**/*.memh
!artifacts/reference_outputs/**/*.csv
!artifacts/reference_outputs/**/*.json
!artifacts/manifests/
!artifacts/manifests/*.json
